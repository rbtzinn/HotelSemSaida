title = "Livro de hóspedes"
text = "Março de 1923. Nomes da semana, quartos e horas de chegada, em letra caprichada.

Na margem, alguém reclamou: \"esperei 20 minutos pelo Bento, o ascensorista\"."
prompt_text = "Ler"

