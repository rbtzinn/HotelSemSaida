[node name="Livro" type="Area3D" parent="WorldToday"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 1.2, 3.5)
script = ExtResource("8_note")
title = "Livro de hóspedes"
text = "O livro está mofado. Na coluna \"Saída\", várias linhas em branco.

A última linha tem a data de hoje, e a tinta ainda está úmida. Uma assinatura recente. A letra parece familiar."
prompt_text = "Ler"
extra_flag = "cozinha.concluida"
extra_text = "Mais acima, um nome que você não tinha notado: Otília, cozinheira. A coluna \"Saída\" está vazia.

A letra é a mesma do lápis no cardápio: \"3 8\"."

